# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings -> API. Required: every page and API route uses these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret key (sb_secret_..., or the legacy service_role key). Server only: never prefix it
# with NEXT_PUBLIC_. Needed for lesson quizzes, recaps and points: the server stores quiz answers
# where learners can't read them and pays for passed quizzes. Without it, quizzes are switched off.
SUPABASE_SECRET_KEY=

# Google AI Studio key. Required for roadmap, notes, quiz, instructor, and career-guidance generation.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.6-flash) or route calls through a proxy.
GEMINI_MODEL=
GEMINI_BASE_URL=
# Optional: comma-separated models to try when the main one is busy or out of free quota
# (default: gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash).
GEMINI_FALLBACK_MODELS=

# Adzuna job search (https://developer.adzuna.com). Optional: /api/jobs/search serves mock jobs when unset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# YouTube Data API v3 key. Required for the lecture suggestions on roadmap topics.
YOUTUBE_API_KEY=

# Optional: where the sign-up confirmation email redirects. Defaults to <current origin>/dashboard.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
